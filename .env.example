# View 服务的 HTTP 监听地址。
VIEW_LISTEN_ADDR=:8080
# MySQL 数据源名称（DSN），用于连接并读写路径与拓扑数据。
MYSQL_DSN=root:@tcp(127.0.0.1:3306)/pathroute?charset=utf8mb4&parseTime=True&loc=Local
# 数据库为空时，是否从图 JSON 文件导入初始化数据。
SEED_FROM_JSON=true
# 初始化图数据所使用的 JSON 文件路径。
GRAPH_JSON_PATH=data/graph.json

# 是否启用动态指标采集、聚合以及基于指标的动态路由。
DYNAMIC_METRICS_ENABLED=false
# 检查模拟指标配置变更的间隔；每条配置的生成周期仍由其自身设置决定。
METRIC_SAMPLE_INTERVAL=2s
# 将原始指标聚合为链路 cost 的执行间隔。
METRIC_AGGREGATION_INTERVAL=2s
# 指标聚合与平滑计算使用的时间窗口。
METRIC_AGGREGATION_WINDOW=10s
# 协议指标的过期阈值，超过该时长未更新的指标将视为失效。
METRIC_EXPIRY_THRESHOLD=30s
# 计算 UDP 链路 cost 时使用的丢包惩罚系数。
METRIC_UDP_LOSS_PENALTY=1000
# 触发普通 cost 变更确认所需的最小相对变化比例，0.10 表示 10%。即cost 变化超过 10% 时才会触发变更和路由更新。
METRIC_COST_CHANGE_THRESHOLD=0.10
# 普通 cost 变化连续达到阈值多少次后才确认变更。
METRIC_COST_CONFIRMATIONS=3
# 两次普通自动路由更新之间允许的最短间隔。用于防止指标频繁波动导致路由不断切换。这个“防抖时间”，值越大路由越稳定，但响应普通网络变化越慢。
METRIC_MIN_ROUTE_INTERVAL=30s
# 写入指标快照的 cost 计算公式版本标识。
METRIC_FORMULA_VERSION=v1
# 客户端上报的观测时间允许领先服务器当前时间的最大时长。
METRIC_MAX_FUTURE_SKEW=5m
# 查询历史指标时默认返回的最大记录数。
METRIC_DEFAULT_QUERY_LIMIT=200
# 历史指标查询及模拟配置批量操作允许的最大记录数。
METRIC_MAX_QUERY_LIMIT=1000
# 单次指标上报允许包含的最大样本数。
METRIC_MAX_REPORT_BATCH=1000

# ClickHouse 原生协议地址列表，多个地址使用英文逗号分隔。
CLICKHOUSE_ADDRS=127.0.0.1:9000
# ClickHouse 数据库名称。
CLICKHOUSE_DATABASE=default
# ClickHouse 登录用户名。
CLICKHOUSE_USERNAME=default
# ClickHouse 登录密码；无密码时保持为空。
CLICKHOUSE_PASSWORD=
# 连接 ClickHouse 时的建连超时时间。
CLICKHOUSE_DIAL_TIMEOUT=5s
# 单次 ClickHouse 查询或写入操作的超时时间。
CLICKHOUSE_QUERY_TIMEOUT=5s
# ClickHouse 连接池允许的最大打开连接数。
CLICKHOUSE_MAX_OPEN_CONNS=10
# ClickHouse 连接池允许保留的最大空闲连接数。
CLICKHOUSE_MAX_IDLE_CONNS=5
# ClickHouse 连接在连接池中的最长复用时间。
CLICKHOUSE_CONN_MAX_LIFETIME=30m

# View 服务收到退出信号后等待 HTTP 优雅关闭完成的最长时间。
VIEW_SHUTDOWN_TIMEOUT=10s
